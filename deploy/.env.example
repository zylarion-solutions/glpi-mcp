# Settings for deploy/docker-compose.yml (OAuth mode next to GLPI). Copy to .env and fill in.
# Transport, port and OAuth mode are fixed in docker-compose.yml.

# GLPI as seen from this host: its public https name (resolved to 127.0.0.1 by extra_hosts),
# or http://127.0.0.1 if the web server answers GLPI there.
GLPI_URL=https://servicedesk.example.com
GLPI_API_MODE=legacy
# Only if the GLPI API client you use has an App-Token (the default localhost client has none)
GLPI_APP_TOKEN=

# Start read-only; set to false once the team is comfortable (each person still acts with their own GLPI rights)
GLPI_READ_ONLY=true
GLPI_ALLOW_DELETE=false

# Public https URL of this MCP server; users add <MCP_PUBLIC_URL>/mcp as a connector
MCP_PUBLIC_URL=https://mcp.servicedesk.example.com
# 32+ random characters: openssl rand -hex 32. Changing it signs everyone out.
MCP_OAUTH_SECRET=
# Apps allowed to receive sign-ins (claude.ai and Claude apps by default; loopback is always allowed)
MCP_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com
