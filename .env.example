# ---------------------------------------------------------------- GLPI
# GLPI root URL, without /apirest.php or /api.php
GLPI_URL=https://glpi.example.com

# auto (default) | legacy | hlapi
#   auto: High-Level API if OAuth credentials are set and GLPI offers it (GLPI 11+),
#         otherwise the legacy REST API.
GLPI_API_MODE=auto

# --- Legacy REST API (/apirest.php) - GLPI 9.x, 10, 11
# Setup > General > API: enable the REST API (+ "login with external token").
# App-Token: only if your API client defines one.
GLPI_APP_TOKEN=
# User token: user preferences > Remote access keys > API token.
GLPI_USER_TOKEN=

# --- High-Level API (/api.php, OAuth2) - GLPI 11+
# Setup > OAuth clients: add a client with the Password grant and the "api" scope.
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
# Service user for the password grant (also used as legacy Basic auth if no user token).
GLPI_USERNAME=
GLPI_PASSWORD=
# Password grant user when it differs from GLPI_USERNAME/GLPI_PASSWORD (optional)
GLPI_OAUTH_USERNAME=
GLPI_OAUTH_PASSWORD=
# auto (newest 2.x offered) or an exact version such as 2.3
GLPI_HLAPI_VERSION=auto

# ---------------------------------------------------------------- Safety
# Write tools (create/update tickets, followups, tasks, solutions...) are off by default.
GLPI_READ_ONLY=true
# Delete tool (needs GLPI_READ_ONLY=false too).
GLPI_ALLOW_DELETE=false
GLPI_TIMEOUT_MS=30000
GLPI_MAX_LIMIT=100
# Max attachment size (MB) downloaded or uploaded through the tools
GLPI_MAX_FILE_MB=10

# ---------------------------------------------------------------- MCP transport
# stdio (Claude Desktop / Claude Code) | http (remote, Streamable HTTP on /mcp)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
# token (static bearer token) | oauth (each user signs in with their own GLPI API token; claude.ai connectors)
MCP_AUTH_MODE=token
# Comma-separated list of allowed browser Origins (optional)
MCP_ALLOWED_ORIGINS=
# Behind a reverse proxy: true or the number of proxy hops (for rate limiting by client address)
MCP_TRUST_PROXY=false

# --- token mode
# Clients send "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Let clients act as their own GLPI user by sending "X-GLPI-User-Token: <their API token>"
MCP_ALLOW_USER_TOKENS=false

# --- oauth mode
# Public https URL users add as a connector (the MCP endpoint is <MCP_PUBLIC_URL>/mcp)
MCP_PUBLIC_URL=
# 32+ random characters; encrypts stored sign-ins. Generate with: openssl rand -hex 32
MCP_OAUTH_SECRET=
# Optional encrypted file to keep sign-ins across restarts (e.g. /data/oauth-state.bin)
MCP_OAUTH_STATE_FILE=
# Token lifetimes in seconds
MCP_OAUTH_ACCESS_TTL=3600
MCP_OAUTH_REFRESH_TTL=2592000
