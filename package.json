{
  "name": "glpi-mcp",
  "version": "0.2.0",
  "description": "MCP server for GLPI (legacy REST API and GLPI 11+ High-Level API) for Claude",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "glpi",
    "itsm",
    "claude",
    "model-context-protocol"
  ],
  "author": "Javier S. Flórez",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "glpi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  }
}
